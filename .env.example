# Set these in Vercel > Project > Settings > Environment Variables.
# DO NOT put actual secrets in the repository or config.js.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_JWT
SUPABASE_SERVICE_ROLE_KEY=SET_ONLY_IN_VERCEL
TURNSTILE_SITE_KEY=YOUR_PUBLIC_SITE_KEY
TURNSTILE_SECRET_KEY=SET_ONLY_IN_VERCEL
TURNSTILE_HOSTNAME=YOUR-PRODUCTION-DOMAIN.vercel.app
UPLOAD_HMAC_SECRET=GENERATE_WITH_openssl_rand_hex_32
CRON_SECRET=GENERATE_DIFFERENT_RANDOM_SECRET
